# Copy to .env on the VPS. Use a dedicated database password.
# DOMAIN must have an A/AAAA record pointing at the VPS before certificate issuance.
DOMAIN=example.com
POSTGRES_DB=autospectrum
POSTGRES_USER=autospectrum
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode the password here if it contains URI punctuation. It must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://autospectrum:replace-with-a-long-random-password@db:5432/autospectrum
# Immutable image tags built and pushed from CI or a workstation.
WEB_IMAGE=ghcr.io/your-org/autospectrum-web:replace-with-git-sha
API_IMAGE=ghcr.io/your-org/autospectrum-api:replace-with-git-sha
